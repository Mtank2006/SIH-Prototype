# ==============================================================================
# RoadMitra (SIH 2026 - Problem SIH26124) — Environment Configuration
# ==============================================================================
# Copy this file to `.env`:
#   cp .env.example .env

# ── Inference Mode ────────────────────────────────────────────────────────────
# 0 = Run real YOLO models (pothole + street)
# 1 = Mock / deterministic stub mode (no GPU/model required for quick testing)
ROADFIX_STUB_MODELS=0

# ── Model Weights (Paths relative to repo root or absolute) ────────────────────
# Weights can be auto-downloaded with: python scripts/download_models.py
POTHOLE_MODEL_PATH=Model/SIH2026-PROTOTYPE/peterhdd_pothole.pt
YOLO_STREET_WEIGHTS=Model/SIH2026-PROTOTYPE/yolov8n.pt

# ── Pothole Detection Tuning ──────────────────────────────────────────────────
# Confidence threshold for pothole detection (0.15 - 0.35)
POTHOLE_CONF=0.18

# Sampling frame rate (FPS) extracted from dashcam video
FRAMES_PER_SECOND=20.0

# IoU matching threshold for deduplicating potholes across consecutive frames
POTHOLE_IOU_MATCH=0.25

# Road Region of Interest: discards detections in upper 35% of frame (sky/glare)
ROAD_ROI_MIN_Y=0.35

# ── Optional VLM Verification Endpoint (OpenAI / Qwen / Ollama / vLLM) ────────
# If set, candidate potholes can be secondary-audited by a Vision-Language Model
# VLM_BASE_URL=https://api.openai.com/v1
# VLM_API_KEY=your_api_key_here
# VLM_MODEL=gpt-4o-mini
# VLM_TIMEOUT_S=30.0
