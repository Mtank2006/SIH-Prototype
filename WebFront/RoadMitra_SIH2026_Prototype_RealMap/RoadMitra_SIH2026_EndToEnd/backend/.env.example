# RoadMitra Integrated Backend — environment variables
# Copy this file to .env and fill the values you need.

# ── Demo / development ────────────────────────────────────────────────────────
# Set to 1 for deterministic stub results (no GPU or VLM endpoint needed)
ROADFIX_STUB_MODELS=1

# ── YOLOv8 models ────────────────────────────────────────────────────────────
# Street eye: COCO model (auto-downloaded by Ultralytics if not present)
YOLO_STREET_WEIGHTS=yolov8n.pt

# Pothole eye: supply a path to your RDD2022-trained YOLOv8 .pt
# If absent, the pothole eye is disabled — only street detections run.
# POTHOLE_MODEL_PATH=/absolute/path/to/road_damage.pt

# ── VLM verification (required for ROADFIX_STUB_MODELS != 1) ─────────────────
# Any OpenAI-compatible endpoint works (vLLM, Ollama OpenAI-compat, DashScope…)
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_API_KEY=ollama
# VLM_MODEL=qwen2.5-vl-7b-instruct
# VLM_JSON_MODE=auto      # auto | off  (set off if endpoint rejects response_format)
# VLM_TIMEOUT_S=30.0

# ── Frame sampling ────────────────────────────────────────────────────────────
# Increase for faster-moving scenes (5.0 urban, 10.0 highway)
# FRAMES_PER_SECOND=2.5

# ── Data directory ────────────────────────────────────────────────────────────
# All frames, snapshots and run artifacts land here.
# Defaults to ./data relative to the backend directory.
# ROADFIX_DATA_DIR=./data
